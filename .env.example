# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Server-only: generate with `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"` (works on Windows/macOS/Linux).
# Must decode to exactly 32 bytes. Never use NEXT_PUBLIC_ for this.
FIELD_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY

# Optional app URL
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Recommended for shared/distributed rate limiting (Upstash Redis REST credentials)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
